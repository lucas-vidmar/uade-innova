{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "15113513492900100586"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "metadata": {
        "description": "Azure region for resources."
      }
    },
    "functionAppName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Function App."
      }
    },
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Storage Account required by the Function runtime."
      }
    },
    "appInsightsConnectionString": {
      "type": "string",
      "metadata": {
        "description": "Application Insights connection string."
      }
    },
    "openAiEndpoint": {
      "type": "string",
      "metadata": {
        "description": "Azure OpenAI endpoint."
      }
    },
    "openAiChatDeployment": {
      "type": "string",
      "metadata": {
        "description": "Azure OpenAI chat model deployment name."
      }
    },
    "openAiEmbeddingDeployment": {
      "type": "string",
      "metadata": {
        "description": "Azure OpenAI embedding model deployment name."
      }
    },
    "openAiTtsDeployment": {
      "type": "string",
      "metadata": {
        "description": "Azure OpenAI TTS model deployment name."
      }
    },
    "classMaterialsStorageAccount": {
      "type": "string",
      "metadata": {
        "description": "Azure Storage account name for class materials."
      }
    },
    "pineconeIndexName": {
      "type": "string",
      "defaultValue": "dashboard-edu-pilot",
      "metadata": {
        "description": "Pinecone index name for vectors."
      }
    },
    "pineconeEnvironment": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Pinecone environment (optional when host is provided)."
      }
    },
    "pineconeHost": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Pinecone host endpoint (optional but recommended)."
      }
    },
    "pineconeApiKeySecretName": {
      "type": "string",
      "defaultValue": "PINECONE-API-KEY",
      "metadata": {
        "description": "Key Vault secret name that stores the Pinecone API key."
      }
    },
    "keyVaultUri": {
      "type": "string",
      "metadata": {
        "description": "Key Vault URI."
      }
    },
    "storageAccountId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the Storage account."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Tags to apply to resources."
      }
    },
    "classMaterialsContainerName": {
      "type": "string",
      "defaultValue": "class-materials",
      "metadata": {
        "description": "Name of the Storage container for class materials."
      }
    },
    "allowedCorsOrigin": {
      "type": "string",
      "defaultValue": "*",
      "metadata": {
        "description": "Allowed CORS origin (e.g., https://myapp.azurestaticapps.net). Use \"*\" only during development."
      }
    },
    "materialsTableName": {
      "type": "string",
      "defaultValue": "materials",
      "metadata": {
        "description": "Table name for material state entities."
      }
    },
    "classesTableName": {
      "type": "string",
      "defaultValue": "classes",
      "metadata": {
        "description": "Table name for class state entities."
      }
    },
    "enrollmentsTableName": {
      "type": "string",
      "defaultValue": "Enrollments",
      "metadata": {
        "description": "Table name for enrollment entities."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}-plan', parameters('functionAppName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "Y1",
        "tier": "Dynamic"
      },
      "kind": "functionapp",
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "name": "[parameters('functionAppName')]",
      "location": "[parameters('location')]",
      "tags": "[union(parameters('tags'), createObject('azd-service-name', 'backend'))]",
      "kind": "functionapp,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', format('{0}-plan', parameters('functionAppName')))]",
        "reserved": true,
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "NODE|20",
          "functionAppScaleLimit": 10,
          "minimumElasticInstanceCount": 0,
          "use32BitWorkerProcess": false,
          "ipSecurityRestrictions": [],
          "scmIpSecurityRestrictionsUseMain": true,
          "cors": {
            "allowedOrigins": [
              "[parameters('allowedCorsOrigin')]"
            ],
            "supportCredentials": false
          },
          "appSettings": [
            {
              "name": "AzureWebJobsStorage",
              "value": "[format('DefaultEndpointsProtocol=https;AccountName={0};AccountKey={1};EndpointSuffix={2}', parameters('storageAccountName'), listKeys(parameters('storageAccountId'), '2023-01-01').keys[0].value, environment().suffixes.storage)]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "node"
            },
            {
              "name": "WEBSITE_NODE_DEFAULT_VERSION",
              "value": "~20"
            },
            {
              "name": "AzureWebJobsFeatureFlags",
              "value": "EnableWorkerIndexing"
            },
            {
              "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
              "value": "true"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[parameters('appInsightsConnectionString')]"
            },
            {
              "name": "AZURE_OPENAI_ENDPOINT",
              "value": "[parameters('openAiEndpoint')]"
            },
            {
              "name": "AZURE_OPENAI_CHAT_DEPLOYMENT",
              "value": "[parameters('openAiChatDeployment')]"
            },
            {
              "name": "AZURE_OPENAI_EMBEDDING_DEPLOYMENT",
              "value": "[parameters('openAiEmbeddingDeployment')]"
            },
            {
              "name": "AZURE_OPENAI_TTS_DEPLOYMENT",
              "value": "[parameters('openAiTtsDeployment')]"
            },
            {
              "name": "AZURE_STORAGE_ACCOUNT_NAME",
              "value": "[parameters('classMaterialsStorageAccount')]"
            },
            {
              "name": "AZURE_STORAGE_CONTAINER_MATERIALS",
              "value": "[parameters('classMaterialsContainerName')]"
            },
            {
              "name": "AZURE_TABLE_MATERIALS",
              "value": "[parameters('materialsTableName')]"
            },
            {
              "name": "AZURE_TABLE_CLASSES",
              "value": "[parameters('classesTableName')]"
            },
            {
              "name": "AZURE_TABLE_ENROLLMENTS",
              "value": "[parameters('enrollmentsTableName')]"
            },
            {
              "name": "AZURE_STORAGE_ENROLLMENTS_TABLE",
              "value": "[parameters('enrollmentsTableName')]"
            },
            {
              "name": "PINECONE_INDEX_NAME",
              "value": "[parameters('pineconeIndexName')]"
            },
            {
              "name": "PINECONE_ENVIRONMENT",
              "value": "[parameters('pineconeEnvironment')]"
            },
            {
              "name": "PINECONE_HOST",
              "value": "[parameters('pineconeHost')]"
            },
            {
              "name": "PINECONE_API_KEY",
              "value": "[format('@Microsoft.KeyVault(SecretUri={0}secrets/{1}/)', parameters('keyVaultUri'), parameters('pineconeApiKeySecretName'))]"
            },
            {
              "name": "NODE_ENV",
              "value": "production"
            },
            {
              "name": "SWA_ROLES_SECRET",
              "value": "[format('@Microsoft.KeyVault(SecretUri={0}secrets/SWA-ROLES-SECRET/)', parameters('keyVaultUri'))]"
            },
            {
              "name": "FRONT_DOOR_ID",
              "value": "[format('@Microsoft.KeyVault(SecretUri={0}secrets/FRONT-DOOR-ID/)', parameters('keyVaultUri'))]"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', format('{0}-plan', parameters('functionAppName')))]"
      ]
    }
  ],
  "outputs": {
    "functionAppName": {
      "type": "string",
      "metadata": {
        "description": "The name of the Function App."
      },
      "value": "[parameters('functionAppName')]"
    },
    "functionAppHostName": {
      "type": "string",
      "metadata": {
        "description": "The default hostname of the Function App."
      },
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2023-01-01').defaultHostName]"
    },
    "functionAppUri": {
      "type": "string",
      "metadata": {
        "description": "The full URI of the Function App."
      },
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2023-01-01').defaultHostName)]"
    },
    "functionAppId": {
      "type": "string",
      "metadata": {
        "description": "The resource ID of the Function App."
      },
      "value": "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]"
    }
  }
}