{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "opencode/muse-spark-1.3-contributor-free",
  "plugin": [],
  "provider": {
    "azure-uade-flash": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Azure UADE Dev-Tools (Flash)",
      "options": {
        "baseURL": "https://aiservices-devtools.cognitiveservices.azure.com/openai/deployments/deepseek-v4-flash",
        "queryParams": {
          "api-version": "2024-10-21"
        },
        "headers": {
          "api-key": "{env:AZURE_OPENAI_API_KEY}"
        }
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (UADE Dev-Tools)",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "permission": {
    "external_directory": "allow",
    "bash": {
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git *": "ask",
      "git push*": "deny",
      "*": "allow"
    }
  },
  "server": {
    "port": 4096
  },
  "mcp": {
    "timeout": {
      "startup": 45000
    },
    "servers": {
      "playwright": {
        "type": "local",
        "disabled": true,
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ]
      },
      "azure-mcp-server": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@azure/mcp@2.0.5",
          "server",
          "start"
        ],
        "timeout": {
          "startup": 120000
        }
      },
      "stitch": {
        "type": "remote",
        "url": "https://stitch.googleapis.com/mcp",
        "headers": {
          "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
        }
      }
    }
  }
}
