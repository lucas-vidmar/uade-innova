{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": [],
  "server": {
    "port": 4096
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "azure-mcp-server": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ]
    }
  }
}
