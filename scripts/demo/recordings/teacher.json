{
  "url": "${DEMO_BASE_URL}/#/login",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "cursor": {
    "style": "default",
    "size": 48
  },
  "chrome": {
    "title": "UADE Innova — Dashboard Educativo"
  },
  "background": {
    "padding": 48,
    "gradient": [
      "#00405C",
      "#0A7EA4"
    ]
  },
  "speed": 1.0,
  "outputFormat": "mp4",
  "waitForSelector": "#login-email",
  "steps": [
    {
      "action": "wait",
      "ms": 2500
    },
    {
      "action": "hover",
      "selector": "#login-email"
    },
    {
      "action": "type",
      "selector": "#login-email",
      "text": "${DEMO_TEACHER_EMAIL}",
      "delay": 45
    },
    {
      "action": "wait",
      "ms": 300
    },
    {
      "action": "type",
      "selector": "#login-password",
      "text": "${DEMO_TEACHER_PASSWORD}",
      "delay": 45
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "click",
      "selector": "#login-submit"
    },
    {
      "action": "wait",
      "ms": 6000
    },
    {
      "action": "screenshot",
      "name": "teacher-dashboard"
    },
    {
      "action": "wait",
      "ms": 1500
    },
    {
      "action": "navigate",
      "url": "${DEMO_BASE_URL}/#/teacher/classes"
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "screenshot",
      "name": "teacher-classes"
    },
    {
      "action": "navigate",
      "url": "${DEMO_BASE_URL}/#/teacher/upload"
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "hover",
      "selector": "#upload-zone-wrapper"
    },
    {
      "action": "wait",
      "ms": 1500
    },
    {
      "action": "screenshot",
      "name": "teacher-upload"
    },
    {
      "action": "navigate",
      "url": "${DEMO_BASE_URL}/#/teacher/corrections"
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "screenshot",
      "name": "teacher-corrections"
    },
    {
      "action": "navigate",
      "url": "${DEMO_BASE_URL}/#/teacher/analytics"
    },
    {
      "action": "wait",
      "ms": 3500
    },
    {
      "action": "screenshot",
      "name": "teacher-analytics"
    },
    {
      "action": "wait",
      "ms": 1500
    }
  ]
}
