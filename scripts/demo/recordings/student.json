{
  "url": "${DEMO_BASE_URL}/#/login",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "cursor": {
    "style": "default",
    "size": 48
  },
  "chrome": {
    "title": "UADE Innova — Dashboard Educativo"
  },
  "background": {
    "padding": 48,
    "gradient": [
      "#00405C",
      "#0A7EA4"
    ]
  },
  "speed": 1.0,
  "outputFormat": "mp4",
  "waitForSelector": "#login-email",
  "steps": [
    {
      "action": "wait",
      "ms": 2500
    },
    {
      "action": "hover",
      "selector": "#login-email"
    },
    {
      "action": "type",
      "selector": "#login-email",
      "text": "${DEMO_STUDENT_EMAIL}",
      "delay": 45
    },
    {
      "action": "wait",
      "ms": 300
    },
    {
      "action": "type",
      "selector": "#login-password",
      "text": "${DEMO_STUDENT_PASSWORD}",
      "delay": 45
    },
    {
      "action": "wait",
      "ms": 600
    },
    {
      "action": "click",
      "selector": "#login-submit"
    },
    {
      "action": "wait",
      "ms": 7000
    },
    {
      "action": "screenshot",
      "name": "student-dashboard"
    },
    {
      "action": "wait",
      "ms": 2000
    },
    {
      "action": "hover",
      "selector": "#global-search-header"
    },
    {
      "action": "type",
      "selector": "#global-search-header",
      "text": "arquitectura",
      "delay": 60
    },
    {
      "action": "wait",
      "ms": 2000
    },
    {
      "action": "screenshot",
      "name": "student-busqueda"
    },
    {
      "action": "scroll",
      "selector": "#section-classes"
    },
    {
      "action": "wait",
      "ms": 1500
    },
    {
      "action": "scroll",
      "selector": "#section-tasks"
    },
    {
      "action": "wait",
      "ms": 1500
    },
    {
      "action": "click",
      "selector": "#chat-chips button:first-child"
    },
    {
      "action": "wait",
      "ms": 900
    },
    {
      "action": "hover",
      "selector": "#chat-input"
    },
    {
      "action": "click",
      "selector": "#chat-input"
    },
    {
      "action": "type",
      "selector": "#chat-input",
      "text": "¿Qué es una arquitectura de software por capas?",
      "delay": 35
    },
    {
      "action": "wait",
      "ms": 600
    },
    {
      "action": "click",
      "selector": "#chat-send"
    },
    {
      "action": "wait",
      "ms": 16000
    },
    {
      "action": "screenshot",
      "name": "student-rag-respuesta"
    },
    {
      "action": "navigate",
      "url": "${DEMO_BASE_URL}/#/student/tasks"
    },
    {
      "action": "wait",
      "ms": 4000
    },
    {
      "action": "screenshot",
      "name": "student-tareas"
    },
    {
      "action": "navigate",
      "url": "${DEMO_BASE_URL}/#/student/calendar"
    },
    {
      "action": "wait",
      "ms": 4000
    },
    {
      "action": "screenshot",
      "name": "student-calendario"
    },
    {
      "action": "navigate",
      "url": "${DEMO_BASE_URL}/#/student/reports"
    },
    {
      "action": "wait",
      "ms": 3500
    },
    {
      "action": "screenshot",
      "name": "student-reportes"
    },
    {
      "action": "wait",
      "ms": 1500
    }
  ]
}
