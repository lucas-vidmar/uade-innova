{
  "url": "${DEMO_BASE_URL}/#/login",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "cursor": {
    "style": "default",
    "size": 48
  },
  "chrome": {
    "title": "UADE Innova — Dashboard Educativo"
  },
  "background": {
    "padding": 48,
    "gradient": [
      "#00405C",
      "#0A7EA4"
    ]
  },
  "speed": 1.0,
  "outputFormat": "mp4",
  "waitForSelector": "#login-email",
  "steps": [
    {
      "action": "wait",
      "ms": 2500
    },
    {
      "action": "hover",
      "selector": "#login-email"
    },
    {
      "action": "type",
      "selector": "#login-email",
      "text": "${DEMO_DIRECTOR_EMAIL}",
      "delay": 45
    },
    {
      "action": "wait",
      "ms": 300
    },
    {
      "action": "type",
      "selector": "#login-password",
      "text": "${DEMO_DIRECTOR_PASSWORD}",
      "delay": 45
    },
    {
      "action": "wait",
      "ms": 600
    },
    {
      "action": "click",
      "selector": "#login-submit"
    },
    {
      "action": "wait",
      "ms": 7000
    },
    {
      "action": "screenshot",
      "name": "director-dashboard"
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "hover",
      "selector": "#kpi-export-bar"
    },
    {
      "action": "wait",
      "ms": 1500
    },
    {
      "action": "screenshot",
      "name": "director-kpis"
    },
    {
      "action": "navigate",
      "url": "${DEMO_BASE_URL}/#/director/interventions"
    },
    {
      "action": "wait",
      "ms": 4000
    },
    {
      "action": "screenshot",
      "name": "director-intervenciones"
    },
    {
      "action": "navigate",
      "url": "${DEMO_BASE_URL}/#/director/subjects"
    },
    {
      "action": "wait",
      "ms": 4000
    },
    {
      "action": "screenshot",
      "name": "director-materias"
    },
    {
      "action": "navigate",
      "url": "${DEMO_BASE_URL}/#/director/students"
    },
    {
      "action": "wait",
      "ms": 4000
    },
    {
      "action": "screenshot",
      "name": "director-alumnos"
    },
    {
      "action": "navigate",
      "url": "${DEMO_BASE_URL}/#/director/sat-analytics"
    },
    {
      "action": "wait",
      "ms": 4000
    },
    {
      "action": "screenshot",
      "name": "director-sat"
    },
    {
      "action": "wait",
      "ms": 1500
    }
  ]
}
