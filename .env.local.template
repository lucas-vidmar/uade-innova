# ============================================================
# .env.local.template — Variables de entorno para desarrollo local
# Dashboard Educativo Inteligente — UADE
# ============================================================
#
# INSTRUCCIONES:
# 1. Copia este archivo como .env.local (nunca commitees .env.local)
# 2. Ejecutá: azd provision
# 3. Ejecutá: azd env get-values > .env.local para rellenar automáticamente
# 4. Completá los valores manuales marcados con [MANUAL]
#
# ============================================================

# ── Azure OpenAI ──────────────────────────────────────────────
# Obtenido automáticamente de: azd env get-values
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Para desarrollo local: usar API Key (no Managed Identity)
# Obtenerla desde: Azure Portal → OpenAI → Keys & Endpoint
AZURE_OPENAI_API_KEY=<tu-api-key-para-dev-local>  # [MANUAL]

# ── Pinecone ──────────────────────────────────────────────────
# Crear cuenta en: https://app.pinecone.io
# Crear índice: dashboard-edu-pilot | 1536 dimensiones | métrica Cosine
PINECONE_API_KEY=<tu-pinecone-api-key>  # [MANUAL] — luego setear en Key Vault
PINECONE_INDEX_NAME=dashboard-edu-pilot
PINECONE_ENVIRONMENT=<tu-environment>   # [MANUAL] ej: us-east-1

# ── Azure Storage ─────────────────────────────────────────────
# Obtenido automáticamente de: azd env get-values
AZURE_STORAGE_ACCOUNT_NAME=<nombre-storage-account>
AZURE_STORAGE_CONTAINER_MATERIALS=class-materials

# Para dev local con Managed Identity no disponible:
AZURE_STORAGE_CONNECTION_STRING=<cadena-de-conexion-dev>  # [MANUAL]

# ── Identity (Managed Identity en producción) ─────────────────
# En producción estas variables son inyectadas automáticamente por Azure
# En local: usar las credenciales del Azure CLI (az login)
AZURE_CLIENT_ID=   # Dejar vacío para usar DefaultAzureCredential con az login
AZURE_TENANT_ID=<tenant-id-de-tu-suscripcion>  # [MANUAL]

# ── CORS ───────────────────────────────────────────────────────
# Orígenes permitidos para CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:4280,http://localhost:5173

# ── App URLs ──────────────────────────────────────────────────
# Backend (Azure Functions corriendo localmente con: func start)
VITE_API_BASE_URL=http://localhost:7071/api

# En producción (obtenido de azd env get-values):
# VITE_API_BASE_URL=https://func-dashboard-ingest-<token>.azurewebsites.net/api

# ── Observabilidad ────────────────────────────────────────────
# Obtenido automáticamente de: azd env get-values
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# Nivel de log: debug | info | warn | error (default: info)
LOG_LEVEL=info

# ── Key Vault ─────────────────────────────────────────────────
# Obtenido automáticamente de: azd env get-values
AZURE_KEY_VAULT_URI=https://<nombre-kv>.vault.azure.net/
