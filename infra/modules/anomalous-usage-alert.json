{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "13369205604969593958"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "metadata": {
        "description": "Azure region for monitor resources."
      }
    },
    "workspaceId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the Log Analytics Workspace connected to App Insights."
      }
    },
    "notificationEmail": {
      "type": "string",
      "metadata": {
        "description": "Email destination for alert notifications."
      }
    },
    "webhookUri": {
      "type": "securestring",
      "defaultValue": "",
      "maxLength": 2000,
      "metadata": {
        "description": "Optional webhook URI for Teams/HTTP notification channel (e.g. Teams connector). Empty string disables webhook."
      }
    },
    "scheduledQueryRuleName": {
      "type": "string",
      "defaultValue": "alert-anomalous-token-usage",
      "metadata": {
        "description": "Name of the scheduled query alert rule."
      }
    },
    "actionGroupName": {
      "type": "string",
      "defaultValue": "ag-anomalous-token-usage",
      "metadata": {
        "description": "Name of the action group that sends email notifications."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Tags to apply to resources."
      }
    },
    "subjectTokenThreshold": {
      "type": "int",
      "defaultValue": 500000,
      "metadata": {
        "description": "Threshold for per-subject token anomaly alert (tokens per userId+subjectId over 24h)."
      }
    },
    "warningTokenThreshold": {
      "type": "int",
      "defaultValue": 750000,
      "metadata": {
        "description": "Threshold for warning-tier token anomaly alert (tokens per user over 24h, before critical threshold)."
      }
    },
    "requestCountThreshold": {
      "type": "int",
      "defaultValue": 100,
      "metadata": {
        "description": "Threshold for per-user request count anomaly alert (RAG requests per user over 1h)."
      }
    }
  },
  "variables": {
    "trimmedWebhookUri": "[trim(parameters('webhookUri'))]",
    "tokenThreshold": 1000000,
    "perSubjectQueryTemplate": "AppEvents\n| where Name == \"RAGInteraction\"\n| where TimeGenerated >= ago(24h)\n| where isnotempty(tostring(Properties.userId)) and isnotempty(tostring(Properties.subjectId))\n| extend userId = tostring(Properties.userId), subjectId = tostring(Properties.subjectId), totalTokens = todouble(Measurements.totalTokens)\n| summarize tokens24h = sum(coalesce(totalTokens, 0.0)) by userId, subjectId\n| where tokens24h > {threshold}\n| project userId, subjectId, tokens24h\n",
    "perSubjectQuery": "[replace(variables('perSubjectQueryTemplate'), '{threshold}', format('{0}', parameters('subjectTokenThreshold')))]",
    "warningQueryTemplate": "AppEvents\n| where Name == \"RAGInteraction\"\n| where TimeGenerated >= ago(24h)\n| where isnotempty(tostring(Properties.userId))\n| extend userId = tostring(Properties.userId), totalTokens = todouble(Measurements.totalTokens)\n| summarize tokens24h = sum(coalesce(totalTokens, 0.0)) by userId\n| where tokens24h > {threshold}\n| project userId, tokens24h\n",
    "warningQuery": "[replace(variables('warningQueryTemplate'), '{threshold}', format('{0}', parameters('warningTokenThreshold')))]",
    "criticalQueryTemplate": "AppEvents\n| where Name == \"RAGInteraction\"\n| where TimeGenerated >= ago(24h)\n| where isnotempty(tostring(Properties.userId))\n| extend userId = tostring(Properties.userId), totalTokens = todouble(Measurements.totalTokens)\n| summarize tokens24h = sum(coalesce(totalTokens, 0.0)) by userId\n| where tokens24h > {threshold}\n| project userId, tokens24h\n",
    "criticalQuery": "[replace(variables('criticalQueryTemplate'), '{threshold}', format('{0}', variables('tokenThreshold')))]",
    "requestCountQueryTemplate": "AppEvents\n| where Name == \"RAGInteraction\"\n| where TimeGenerated >= ago(1h)\n| where isnotempty(tostring(Properties.userId))\n| where tostring(Properties.sandbox) != \"true\" and tostring(Properties.simulateStudent) != \"true\"\n| extend userId = tostring(Properties.userId)\n| summarize requestCount1h = count() by userId\n| where requestCount1h > {threshold}\n| project userId, requestCount1h\n",
    "requestCountQuery": "[replace(variables('requestCountQueryTemplate'), '{threshold}', format('{0}', parameters('requestCountThreshold')))]"
  },
  "resources": [
    {
      "type": "Microsoft.Insights/actionGroups",
      "apiVersion": "2023-01-01",
      "name": "[parameters('actionGroupName')]",
      "location": "global",
      "tags": "[parameters('tags')]",
      "properties": {
        "groupShortName": "TokenAlert",
        "enabled": true,
        "emailReceivers": [
          {
            "name": "operations-email",
            "emailAddress": "[parameters('notificationEmail')]",
            "useCommonAlertSchema": true
          }
        ],
        "webhookReceivers": "[if(not(empty(variables('trimmedWebhookUri'))), createArray(createObject('name', 'operations-webhook', 'serviceUri', variables('trimmedWebhookUri'), 'useCommonAlertSchema', true())), createArray())]"
      }
    },
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[parameters('scheduledQueryRuleName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "description": "Triggers when a single user exceeds 1,000,000 tokens over the last 24 hours.",
        "displayName": "Anomalous token usage (>1M tokens / 24h per user)",
        "severity": 2,
        "enabled": true,
        "scopes": [
          "[parameters('workspaceId')]"
        ],
        "evaluationFrequency": "PT5M",
        "windowSize": "PT24H",
        "criteria": {
          "allOf": [
            {
              "query": "[variables('criticalQuery')]",
              "timeAggregation": "Count",
              "operator": "GreaterThanOrEqual",
              "threshold": 1,
              "dimensions": [
                {
                  "name": "userId",
                  "operator": "Include",
                  "values": [
                    "*"
                  ]
                }
              ],
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "autoMitigate": true,
        "actions": {
          "actionGroups": [
            "[resourceId('Microsoft.Insights/actionGroups', parameters('actionGroupName'))]"
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', parameters('actionGroupName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-per-subject', parameters('scheduledQueryRuleName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "description": "[format('Triggers when a user exceeds {0} tokens in a single subject over the last 24 hours.', parameters('subjectTokenThreshold'))]",
        "displayName": "[format('Per-subject anomalous token usage (>{0} tokens / 24h per subject+user)', parameters('subjectTokenThreshold'))]",
        "severity": 2,
        "enabled": true,
        "scopes": [
          "[parameters('workspaceId')]"
        ],
        "evaluationFrequency": "PT5M",
        "windowSize": "PT24H",
        "criteria": {
          "allOf": [
            {
              "query": "[variables('perSubjectQuery')]",
              "timeAggregation": "Count",
              "operator": "GreaterThanOrEqual",
              "threshold": 1,
              "dimensions": [
                {
                  "name": "userId",
                  "operator": "Include",
                  "values": [
                    "*"
                  ]
                },
                {
                  "name": "subjectId",
                  "operator": "Include",
                  "values": [
                    "*"
                  ]
                }
              ],
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "autoMitigate": true,
        "actions": {
          "actionGroups": [
            "[resourceId('Microsoft.Insights/actionGroups', parameters('actionGroupName'))]"
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', parameters('actionGroupName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-warning', parameters('scheduledQueryRuleName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "description": "[format('Triggers when a single user exceeds {0} tokens over the last 24 hours (warning tier before critical threshold).', parameters('warningTokenThreshold'))]",
        "displayName": "[format('Elevated token usage (>{0} tokens / 24h per user)', parameters('warningTokenThreshold'))]",
        "severity": 1,
        "enabled": true,
        "scopes": [
          "[parameters('workspaceId')]"
        ],
        "evaluationFrequency": "PT5M",
        "windowSize": "PT24H",
        "criteria": {
          "allOf": [
            {
              "query": "[variables('warningQuery')]",
              "timeAggregation": "Count",
              "operator": "GreaterThanOrEqual",
              "threshold": 1,
              "dimensions": [
                {
                  "name": "userId",
                  "operator": "Include",
                  "values": [
                    "*"
                  ]
                }
              ],
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "autoMitigate": true,
        "actions": {
          "actionGroups": [
            "[resourceId('Microsoft.Insights/actionGroups', parameters('actionGroupName'))]"
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', parameters('actionGroupName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-req-count', parameters('scheduledQueryRuleName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "description": "[format('Triggers when a single user exceeds {0} RAG requests over the last hour.', parameters('requestCountThreshold'))]",
        "displayName": "[format('Anomalous request count (>{0} RAG requests / 1h per user)', parameters('requestCountThreshold'))]",
        "severity": 2,
        "enabled": true,
        "scopes": [
          "[parameters('workspaceId')]"
        ],
        "evaluationFrequency": "PT5M",
        "windowSize": "PT1H",
        "criteria": {
          "allOf": [
            {
              "query": "[variables('requestCountQuery')]",
              "timeAggregation": "Count",
              "operator": "GreaterThanOrEqual",
              "threshold": 1,
              "dimensions": [
                {
                  "name": "userId",
                  "operator": "Include",
                  "values": [
                    "*"
                  ]
                }
              ],
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "autoMitigate": true,
        "actions": {
          "actionGroups": [
            "[resourceId('Microsoft.Insights/actionGroups', parameters('actionGroupName'))]"
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', parameters('actionGroupName'))]"
      ]
    }
  ],
  "outputs": {
    "actionGroupId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Insights/actionGroups', parameters('actionGroupName'))]"
    },
    "scheduledQueryRuleId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Insights/scheduledQueryRules', parameters('scheduledQueryRuleName'))]"
    },
    "perSubjectScheduledQueryRuleId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Insights/scheduledQueryRules', format('{0}-per-subject', parameters('scheduledQueryRuleName')))]"
    },
    "warningScheduledQueryRuleId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Insights/scheduledQueryRules', format('{0}-warning', parameters('scheduledQueryRuleName')))]"
    },
    "requestCountScheduledQueryRuleId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Insights/scheduledQueryRules', format('{0}-req-count', parameters('scheduledQueryRuleName')))]"
    },
    "threshold": {
      "type": "int",
      "value": "[variables('tokenThreshold')]"
    },
    "subjectTokenThresholdValue": {
      "type": "int",
      "value": "[parameters('subjectTokenThreshold')]"
    },
    "warningTokenThresholdValue": {
      "type": "int",
      "value": "[parameters('warningTokenThreshold')]"
    },
    "requestCountThresholdValue": {
      "type": "int",
      "value": "[parameters('requestCountThreshold')]"
    }
  }
}