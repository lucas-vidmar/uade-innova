                    "tierToArchive": {
                      "daysAfterModificationGreaterThan": 180
                    }
                  }
                },
                "filters": {
                  "blobTypes": [
                    "blockBlob"
                  ],
                  "prefixMatch": [
                    "class-materials/semester-",
                    "processed/semester-"
                  ]
                }
              }
            },
            {
