<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    
    <!-- Diagram Title -->
    <mxCell id="2" value="Azure Educational Dashboard Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#00405C;" vertex="1" parent="1">
      <mxGeometry x="30" y="20" width="1000" height="40" as="geometry"/>
    </mxCell>
    
    <!-- Azure Boundary (Resource Group) -->
    <mxCell id="rg" value="Resource Group: uade-innova-rg" style="swimlane;whiteSpace=wrap;html=1;startSize=30;dashed=1;dashPattern=1 4;container=1;pointerEvents=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="150" y="100" width="450" height="340" as="geometry"/>
    </mxCell>
    
    <!-- External Entities -->
    <mxCell id="user_node" value="Browser / Client" style="image;aspect=fixed;html=1;points=[];origP=0;image=img/lib/azure2/general/Browser.svg;" vertex="1" parent="1">
      <mxGeometry x="40" y="240" width="50" height="40" as="geometry"/>
    </mxCell>
    
    <!-- Main Application Services inside RG -->
    <mxCell id="swa" value="Azure Static Web App" style="image;aspect=fixed;html=1;points=[];origP=0;image=img/lib/azure2/app_services/Static_Web_Apps.svg;" vertex="1" parent="rg">
      <mxGeometry x="40" y="140" width="64" height="64" as="geometry"/>
    </mxCell>
    
    <mxCell id="func" value="Azure Function App&#xa;(Consumption Y1)" style="image;aspect=fixed;html=1;points=[];origP=0;image=img/lib/azure2/compute/Function_Apps.svg;" vertex="1" parent="rg">
      <mxGeometry x="250" y="140" width="64" height="64" as="geometry"/>
    </mxCell>
    
    <!-- Data Services (Outside RG for logical separation in this diagram) -->
    <mxCell id="storage" value="Azure Storage Account&#xa;(Transcripts &amp; PDFs)" style="image;aspect=fixed;html=1;points=[];origP=0;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1">
      <mxGeometry x="720" y="120" width="64" height="64" as="geometry"/>
    </mxCell>
    
    <mxCell id="pinecone" value="Pinecone&#xa;(Vector Database)" style="image;aspect=fixed;html=1;points=[];origP=0;image=img/lib/azure2/databases/Azure_Database_for_PostgreSQL_servers.svg;" vertex="1" parent="1">
      <mxGeometry x="720" y="240" width="67" height="64" as="geometry"/>
    </mxCell>
    
    <!-- Observability Zone (Outside "Network") -->
    <mxCell id="monitor" value="Azure Monitor" style="image;aspect=fixed;html=1;points=[];origP=0;image=img/lib/azure2/management_governance/Monitor.svg;" vertex="1" parent="1">
      <mxGeometry x="720" y="360" width="64" height="64" as="geometry"/>
    </mxCell>
    
    <mxCell id="sentinel" value="Microsoft Sentinel" style="image;aspect=fixed;html=1;points=[];origP=0;image=img/lib/azure2/security/Microsoft_Sentinel.svg;" vertex="1" parent="1">
      <mxGeometry x="920" y="360" width="64" height="64" as="geometry"/>
    </mxCell>
    
    <!-- Connectivity -->
    <mxCell id="edge_user_swa" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="user_node" target="swa">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <mxCell id="edge_swa_func" value="REST API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="rg" source="swa" target="func">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- FANNED EDGES FROM FUNCTION APP (RIGHT FACE) -->
    <!-- Edge 1: To Storage (exitY=0.35) -->
    <mxCell id="edge_func_storage" value="Blob Operations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.35;entryX=0;entryY=0.5;" edge="1" parent="1" source="func" target="storage">
      <mxGeometry relative="1" x="-0.45" y="-18" as="geometry">
        <Array as="points">
          <mxPoint x="640" y="262"/>
          <mxPoint x="640" y="152"/>
        </Array>
      </mxGeometry>
    </mxCell>
    
    <!-- Edge 2: To Pinecone (exitY=0.52) -->
    <mxCell id="edge_func_pinecone" value="Upsert / Query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.52;entryX=0;entryY=0.5;" edge="1" parent="1" source="func" target="pinecone">
      <mxGeometry relative="1" x="-0.15" y="-2" as="geometry">
        <Array as="points">
          <mxPoint x="680" y="273"/>
          <mxPoint x="680" y="272"/>
        </Array>
      </mxGeometry>
    </mxCell>
    
    <!-- Edge 3: To Azure Monitor (exitY=0.68) -->
    <mxCell id="edge_func_monitor" value="Telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.68;entryX=0;entryY=0.5;strokeDasharray=3 3;" edge="1" parent="1" source="func" target="monitor">
      <mxGeometry relative="1" x="0.25" y="14" as="geometry">
        <Array as="points">
          <mxPoint x="640" y="284"/>
          <mxPoint x="640" y="392"/>
        </Array>
      </mxGeometry>
    </mxCell>
    
    <!-- Dependency: Monitor to Sentinel -->
    <mxCell id="edge_monitor_sentinel" value="Security Incidents" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeDasharray=3 3;" edge="1" parent="1" source="monitor" target="sentinel">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>
